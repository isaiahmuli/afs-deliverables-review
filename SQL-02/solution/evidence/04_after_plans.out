-- Order history
EXPLAIN (ANALYZE, BUFFERS)
SELECT order_id, customer_id, status, created_at
FROM orders
WHERE customer_id = 1
ORDER BY created_at DESC, order_id DESC
LIMIT 20;
                                                                          QUERY PLAN                                                                          
--------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit  (cost=0.42..70.42 rows=20 width=31) (actual time=0.064..0.109 rows=20.00 loops=1)
   Buffers: shared hit=23 read=3
   ->  Index Scan Backward using orders_customer_created_idx on orders  (cost=0.42..8011.68 rows=2289 width=31) (actual time=0.063..0.106 rows=20.00 loops=1)
         Index Cond: (customer_id = 1)
         Index Searches: 1
         Buffers: shared hit=23 read=3
 Planning:
   Buffers: shared hit=140 read=2
 Planning Time: 0.418 ms
 Execution Time: 0.123 ms
(10 rows)

-- Packing queue
EXPLAIN (ANALYZE, BUFFERS)
SELECT order_id, customer_id, status, created_at
FROM orders
WHERE status = 'PENDING'
ORDER BY created_at, order_id
LIMIT 100;
                                                                      QUERY PLAN                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit  (cost=0.29..75.81 rows=100 width=31) (actual time=0.040..0.193 rows=100.00 loops=1)
   Buffers: shared hit=31 read=2
   ->  Index Scan using orders_pending_created_idx on orders  (cost=0.29..13502.16 rows=17879 width=31) (actual time=0.040..0.186 rows=100.00 loops=1)
         Index Searches: 1
         Buffers: shared hit=31 read=2
 Planning:
   Buffers: shared hit=17
 Planning Time: 0.056 ms
 Execution Time: 0.203 ms
(9 rows)

