-- CHECK: a product price must be greater than zero.
-- expect-constraint: product_current_price_ck
-- EXPECTED: fails with psql exit code 3. Verbose errors print the constraint name.
\set VERBOSITY verbose
INSERT INTO product (name, current_price) VALUES ('Free Scarf', 0.00);
psql:/work/sql/violations/v06_check_zero_product_price.sql:5: ERROR:  23514: new row for relation "product" violates check constraint "product_current_price_ck"
DETAIL:  Failing row contains (4, Free Scarf, 0.00).
SCHEMA NAME:  public
TABLE NAME:  product
CONSTRAINT NAME:  product_current_price_ck
LOCATION:  ExecConstraints, execMain.c:2092
