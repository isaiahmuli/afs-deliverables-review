-- 05_order_success.sql: Chloe orders 2 x Linen Shirt M White and 1 x Wrap Dress M Olive.
-- The order, its items, and the stock reductions are one transaction: all happen or none do.
-- Prices are copied from product.current_price at the moment of ordering.
\echo '--- Stock BEFORE'
--- Stock BEFORE
SELECT pv.variant_id, p.name, s.code AS size, c.name AS colour, pv.stock_quantity
FROM product_variant pv JOIN product p USING (product_id) JOIN size s USING (size_id) JOIN colour c USING (colour_id)
WHERE (p.name, s.code, c.name) IN (('Linen Shirt','M','White'), ('Wrap Dress','M','Olive'))
ORDER BY pv.variant_id;
 variant_id |    name     | size | colour | stock_quantity 
------------+-------------+------+--------+----------------
          2 | Linen Shirt | M    | White  |              2
          7 | Wrap Dress  | M    | Olive  |              8
(2 rows)

BEGIN;
BEGIN
INSERT INTO customer_order (customer_id, ordered_at)
SELECT customer_id, '2026-11-16 11:00:00+03' FROM customer WHERE email = 'chloe@example.com'
RETURNING order_id \gset
INSERT 0 1
-- Item 1: 2 x Linen Shirt M White (stock 2 -> 0)
INSERT INTO order_item (order_id, variant_id, quantity, unit_price)
SELECT :order_id, pv.variant_id, 2, p.current_price
FROM product_variant pv JOIN product p USING (product_id) JOIN size s USING (size_id) JOIN colour c USING (colour_id)
WHERE (p.name, s.code, c.name) = ('Linen Shirt', 'M', 'White');
INSERT 0 1
UPDATE product_variant pv SET stock_quantity = pv.stock_quantity - 2
FROM product p, size s, colour c
WHERE p.product_id = pv.product_id AND s.size_id = pv.size_id AND c.colour_id = pv.colour_id
  AND (p.name, s.code, c.name) = ('Linen Shirt', 'M', 'White');
UPDATE 1
-- Item 2: 1 x Wrap Dress M Olive (stock 8 -> 7)
INSERT INTO order_item (order_id, variant_id, quantity, unit_price)
SELECT :order_id, pv.variant_id, 1, p.current_price
FROM product_variant pv JOIN product p USING (product_id) JOIN size s USING (size_id) JOIN colour c USING (colour_id)
WHERE (p.name, s.code, c.name) = ('Wrap Dress', 'M', 'Olive');
INSERT 0 1
UPDATE product_variant pv SET stock_quantity = pv.stock_quantity - 1
FROM product p, size s, colour c
WHERE p.product_id = pv.product_id AND s.size_id = pv.size_id AND c.colour_id = pv.colour_id
  AND (p.name, s.code, c.name) = ('Wrap Dress', 'M', 'Olive');
UPDATE 1
COMMIT;
COMMIT
\echo '--- AFTER COMMIT: the order and both items exist'
--- AFTER COMMIT: the order and both items exist
SELECT o.order_id, cu.email, oi.variant_id, oi.quantity, oi.unit_price
FROM customer_order o JOIN customer cu USING (customer_id) JOIN order_item oi USING (order_id)
WHERE o.order_id = :order_id ORDER BY oi.variant_id;
 order_id |       email       | variant_id | quantity | unit_price 
----------+-------------------+------------+----------+------------
        5 | chloe@example.com |          2 |        2 |      49.00
        5 | chloe@example.com |          7 |        1 |      75.50
(2 rows)

\echo '--- AFTER COMMIT: stock reduced by exactly the ordered quantities'
--- AFTER COMMIT: stock reduced by exactly the ordered quantities
SELECT pv.variant_id, p.name, s.code AS size, c.name AS colour, pv.stock_quantity
FROM product_variant pv JOIN product p USING (product_id) JOIN size s USING (size_id) JOIN colour c USING (colour_id)
WHERE (p.name, s.code, c.name) IN (('Linen Shirt','M','White'), ('Wrap Dress','M','Olive'))
ORDER BY pv.variant_id;
 variant_id |    name     | size | colour | stock_quantity 
------------+-------------+------+--------+----------------
          2 | Linen Shirt | M    | White  |              0
          7 | Wrap Dress  | M    | Olive  |              7
(2 rows)

