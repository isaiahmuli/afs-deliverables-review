{
  "info": {
    "name": "SPR-03 starter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "One worked request shows how a check is written. Add your own requests and checks for every outcome."
  },
  "item": [
    {
      "name": "Worked example: invoices API document is served",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{invoicesBaseUrl}}/v3/api-docs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 200', () => pm.response.to.have.status(200));",
              "pm.test('is an OpenAPI 3.1 document', () => {",
              "    pm.expect(pm.response.json().openapi).to.match(/^3\\.1/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Provider: send the sample payment report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{paymentReportUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"evt-0001\",\n  \"checkoutId\": \"{{checkoutId}}\",\n  \"status\": \"paid\",\n  \"amountCents\": 120000\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Set paymentReportUrl in the environment to your report endpoint, and checkoutId to a real checkout.",
              "// Add your own checks here."
            ]
          }
        }
      ]
    }
  ]
}