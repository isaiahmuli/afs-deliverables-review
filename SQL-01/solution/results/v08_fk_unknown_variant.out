-- FOREIGN KEY: an order item must point to an existing product option.
-- expect-constraint: order_item_variant_fk
-- EXPECTED: fails with psql exit code 3. Verbose errors print the constraint name.
\set VERBOSITY verbose
INSERT INTO order_item (order_id, variant_id, quantity, unit_price) VALUES (2, 9999, 1, 49.00);
psql:/work/sql/violations/v08_fk_unknown_variant.sql:5: ERROR:  23503: insert or update on table "order_item" violates foreign key constraint "order_item_variant_fk"
DETAIL:  Key (variant_id)=(9999) is not present in table "product_variant".
SCHEMA NAME:  public
TABLE NAME:  order_item
CONSTRAINT NAME:  order_item_variant_fk
LOCATION:  ri_ReportViolation, ri_triggers.c:2826
