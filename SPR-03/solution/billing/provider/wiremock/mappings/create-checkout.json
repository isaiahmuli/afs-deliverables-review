{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/checkouts",
    "bodyPatterns": [
      { "matchesJsonPath": "$.reference" },
      { "matchesJsonPath": "$.amountCents" },
      { "matchesJsonPath": "$.currency" }
    ]
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "checkoutId": "chk-{{jsonPath request.body '$.reference'}}",
      "url": "https://pay.example.com/chk-{{jsonPath request.body '$.reference'}}"
    },
    "transformers": ["response-template"]
  }
}
